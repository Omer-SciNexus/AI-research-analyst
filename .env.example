# Copy this file to .env and adjust.

# Which LLM to use: ollama (local, free, no limits) | groq | google_genai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2

# Ollama server (default local install)
OLLAMA_BASE_URL=http://localhost:11434

# RAG (Stage 1)
EMBEDDING_PROVIDER=ollama          # ollama | fastembed (ONNX in-process, no server; used for deployment)
EMBEDDING_MODEL=nomic-embed-text   # fastembed equivalent: nomic-ai/nomic-embed-text-v1.5-Q
DOCS_DIR=data/docs
VECTOR_DB_PATH=data/qdrant
COLLECTION_NAME=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Hybrid search + re-ranking (Stage 2)
RETRIEVAL_MODE=hybrid              # dense | sparse | hybrid
RERANK=true
FETCH_K=20                         # candidates the re-ranker chooses from
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
MODELS_DIR=data/models

# Research agent (Stage 3)
OLLAMA_NUM_CTX=8192                # context window for local models
CHECKPOINT_DB=data/checkpoints.sqlite
REPORTS_DIR=data/reports

# Evaluation + tracing (Stage 4)
TRACES_DIR=data/traces
EVAL_DIR=data/eval
EVAL_SET=samples/eval_set.json
# LLM judge for faithfulness + the agent's fact-check (defaults to LLM_PROVIDER / LLM_MODEL).
# A 3B model is not a reliable judge; e.g. JUDGE_PROVIDER=groq JUDGE_MODEL=llama-3.3-70b-versatile
JUDGE_PROVIDER=
JUDGE_MODEL=

# Confidence model (Stage 5)
ML_DIR=data/ml
CONFIDENCE_MODEL=data/models/confidence.joblib
SKIP_LOW_CONFIDENCE=true           # reply "not found" without calling the LLM
AUTO_WEB_FALLBACK=true             # research agent's default web mode: auto (true) or off (false)

# API / deployment (Stage 6)
INDEX_SAMPLES_ON_START=false       # index samples/ when the API starts with an empty index
# Optional Langfuse (free cloud tier, no Docker): `uv add langfuse`, then fill these in
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Free cloud tiers (optional) - only needed when LLM_PROVIDER is groq / google_genai
# Groq:   https://console.groq.com/keys      e.g. LLM_MODEL=llama-3.3-70b-versatile
# Gemini: https://aistudio.google.com/apikey e.g. LLM_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GOOGLE_API_KEY=
